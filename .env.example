# ============================================
# GeoBuild AI — Environment Variables
# Copy this file to .env and fill in your keys
# ============================================

# Gemini API (get from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Cesium Ion (get from ion.cesium.com → Access Tokens)
NEXT_PUBLIC_CESIUM_ION_TOKEN=your_cesium_ion_token_here

# PostGIS Database
DATABASE_URL=postgresql://geo:geo@localhost:5432/geobuild
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo
POSTGRES_DB=geobuild

# AI Service
AI_SERVICE_URL=http://localhost:8000
API_SERVICE_URL=http://localhost:3001

# Node environment
NODE_ENV=development
